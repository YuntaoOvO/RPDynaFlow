; NPT equilibration, 200 ps, position restraints kept on
define          = -DPOSRES
integrator      = md
dt              = 0.002
nsteps          = 100000         ; 200 ps
cutoff-scheme   = Verlet
nstlist         = 20
rlist           = 1.2
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12
pme_order       = 4
vdwtype         = cutoff
vdw-modifier    = force-switch
rvdw-switch     = 1.0
rvdw            = 1.2
pbc             = xyz
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4
tcoupl          = v-rescale
tc-grps         = Protein_RNA Water_and_ions
tau_t           = 1.0 1.0
ref_t           = 300 300
pcoupl          = C-rescale
tau_p           = 5.0
ref_p           = 1.0
compressibility = 4.5e-5
gen_vel         = no
continuation    = yes
nstxout         = 0
nstvout         = 0
nstenergy       = 5000
nstlog          = 5000
